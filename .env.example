# =============================================================================
# Mira - plantilla de variables de entorno.  Copiar a .env y completar.
#   cp .env.example .env
# Este archivo SI se versiona; .env NO.  Nunca pongas secretos reales aqui.
# =============================================================================

# --- Base de datos ----------------------------------------------------------
# Desarrollo local: Postgres levantado con `npm run db:up` (docker-compose).
# Puertos 5442 y 5443 en vez de los 5432/5433 habituales: es muy comun tener
# un PostgreSQL instalado en la maquina ocupando el 5432, y en Windows esa
# colision no falla al levantar el contenedor, sino que te conecta en
# silencio al servidor equivocado.  Se pueden cambiar con MIRA_DB_DEV_PORT
# y MIRA_DB_TEST_PORT.
DATABASE_URL="postgresql://mira:mira@localhost:5442/mira_dev?schema=public"
# Prisma necesita una conexion directa (sin pooler) para aplicar migraciones.
# En local apunta al mismo Postgres; en Supabase apunta al puerto 5432.
DIRECT_URL="postgresql://mira:mira@localhost:5442/mira_dev?schema=public"

# Base de datos usada SOLO por la suite de integracion (puerto 5443).
# La suite hace TRUNCATE de todas las tablas: jamas apuntes esto a dev ni a Supabase.
TEST_DATABASE_URL="postgresql://mira:mira@localhost:5443/mira_test?schema=public"

# --- Ambiente desplegado (Supabase) -----------------------------------------
# Supabase entrega dos cadenas distintas y confundirlas es el error clasico:
#   DATABASE_URL -> pooler, puerto 6543, con ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   -> conexion directa, puerto 5432, usada por `prisma migrate`
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- API --------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"
# Secreto para firmar el JWT. Generar con: openssl rand -base64 48
JWT_SECRET="cambiame-por-un-secreto-largo-y-aleatorio-de-al-menos-32-chars"
JWT_EXPIRES_IN="7d"
# Origen exacto del frontend. Con cookies httpOnly NO se puede usar "*".
CORS_ORIGIN="http://localhost:5173"
# Costo de bcrypt: 10 en dev/CI (rapido), 12 en produccion.
BCRYPT_ROUNDS="10"

# --- Web --------------------------------------------------------------------
# Solo las variables con prefijo VITE_ llegan al bundle del navegador.
VITE_API_URL="http://localhost:3000/api"
