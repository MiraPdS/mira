// =============================================================================
// Mira - esquema de datos
//
// Alcance E1: User, Project, ProjectMember, WorkItem, Comment, ActivityLog.
// MIR-43 agrega Sprint y convierte WorkItem.sprintId en una relacion real.
// Organization sigue reservado: organizationId es nullable y aun no tiene FK.
//
// Entrega 2 (MIR-31): los estados del tablero viven en BoardColumn, por
// proyecto. Un WorkItem sin columna es BACKLOG.
//
// Si cambias un enum aqui, cambialo tambien en packages/shared/src/domain.ts
// en el MISMO commit: el frontend no importa @prisma/client a proposito.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooler (puerto 6543) en Supabase; Postgres local en desarrollo.
  url       = env("DATABASE_URL")
  // Conexion directa (puerto 5432).  `prisma migrate` NO funciona contra el
  // pooler de Supabase: por eso las dos URLs.
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum ProjectRole {
  OWNER
  MEMBER
  VIEWER
}

enum WorkItemType {
  EPIC
  STORY
  TASK
  BUG
}

/// MIR-31: lo que significa una columna, se llame como se llame.
enum ColumnCategory {
  TODO
  IN_PROGRESS
  DONE
}

enum WorkItemPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SprintStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum ActivityAction {
  ITEM_CREATED
  ITEM_UPDATED
  ITEM_STATUS_CHANGED
  ITEM_ASSIGNED
  ITEM_DELETED
  COMMENT_ADDED
  MEMBER_ADDED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  PROJECT_UPDATED
}

// -----------------------------------------------------------------------------
// Modelos
// -----------------------------------------------------------------------------

model User {
  id String @id @default(cuid())

  name  String
  email String @unique
  /// Hash bcrypt. Nunca sale de la API: los DTO usan publicUserSchema.
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   ProjectMember[]
  createdItems  WorkItem[]      @relation("WorkItemCreatedBy")
  assignedItems WorkItem[]      @relation("WorkItemAssignee")
  comments      Comment[]
  activities    ActivityLog[]

  @@map("users")
}

model Project {
  id String @id @default(cuid())

  name        String
  /// Prefijo de las tarjetas: la clave MIR produce MIR-1, MIR-2, ...
  key         String  @unique
  description String?

  /// Contador propio del proyecto para generar `reference` sin colisiones.
  /// Se incrementa dentro de la misma transaccion que crea el WorkItem.
  itemCounter Int @default(0)

  /// Reservado para E2 (multi-organizacion). Sin FK todavia.
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      ProjectMember[]
  workItems    WorkItem[]
  sprints      Sprint[]
  activities   ActivityLog[]
  boardColumns BoardColumn[]

  @@index([organizationId])
  @@map("projects")
}

/// Tabla puente que ademas porta el ROL.
/// El rol vive aqui y no en User: la misma persona puede ser OWNER en un
/// proyecto y VIEWER en otro.
model ProjectMember {
  id String @id @default(cuid())

  userId    String
  projectId String
  role      ProjectRole @default(MEMBER)

  joinedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@map("project_members")
}

model Sprint {
  id        String  @id @default(cuid())
  projectId String
  name      String
  goal      String?

  /// Fechas de calendario; el contrato HTTP usa YYYY-MM-DD.
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  status    SprintStatus @default(PLANNED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItems WorkItem[]

  @@index([projectId, startDate, id])
  @@map("sprints")
}

model WorkItem {
  id String @id @default(cuid())

  /// Identificador legible y estable, tipo "MIR-12". Unico en todo el sistema.
  reference String @unique

  projectId String
  title     String
  description String?

  type     WorkItemType     @default(TASK)
  priority WorkItemPriority @default(MEDIUM)

  /// MIR-31: columna del tablero. Null = BACKLOG (no aparece en el tablero).
  columnId String?

  /// Story points. Null = sin estimar.
  estimate Int?
  dueDate  DateTime?

  /// Posicion dentro de su columna del Kanban (para ordenar al arrastrar).
  position Int @default(0)

  assigneeId  String?
  createdById String

  /// Null cuando el item no pertenece a un sprint.
  sprintId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint     Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  /// La llave incluye projectId: la base impide poner un elemento en la
  /// columna de otro proyecto. NoAction: borrar una columna con elementos
  /// falla; MIR-48 exige mover primero sus elementos a otra columna.
  column     BoardColumn?  @relation(fields: [columnId, projectId], references: [id, projectId], onDelete: NoAction)
  assignee   User?         @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy  User          @relation("WorkItemCreatedBy", fields: [createdById], references: [id])
  comments   Comment[]
  activities ActivityLog[]

  // El tablero siempre consulta por proyecto + columna: ese es el indice que importa.
  @@index([projectId, columnId])
  @@index([projectId, sprintId])
  @@index([sprintId])
  @@index([assigneeId])
  @@map("work_items")
}

/// MIR-31: columna del tablero de un proyecto (reemplaza al enum fijo de D8).
model BoardColumn {
  id String @id @default(cuid())

  projectId String
  name      String
  /// Orden en el tablero, de izquierda a derecha. Sin unique a proposito:
  /// reordenar (MIR-48) reescribe varias posiciones en una transaccion.
  position  Int
  category  ColumnCategory

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItems WorkItem[]

  // Destino de la llave compuesta de WorkItem.column.
  @@unique([id, projectId])
  @@index([projectId, position])
  @@map("board_columns")
}

model Comment {
  id String @id @default(cuid())

  body       String
  workItemId String
  authorId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([workItemId, createdAt])
  @@map("comments")
}

/// Historial de cambios relevantes (principio de Trazabilidad del enunciado).
/// Se escribe con una llamada EXPLICITA desde el service, dentro de la misma
/// transaccion que el cambio: o se registran ambos, o ninguno.
model ActivityLog {
  id String @id @default(cuid())

  action    ActivityAction
  projectId String
  /// Null cuando la actividad es del proyecto y no de un item concreto.
  workItemId String?
  actorId   String

  /// Campo modificado y sus valores, cuando aplica. Ej: "priority", "LOW", "HIGH".
  /// En ITEM_STATUS_CHANGED (MIR-49) son nombres de columna, o "BACKLOG".
  field     String?
  fromValue String?
  toValue   String?

  createdAt DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  actor    User      @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([workItemId, createdAt])
  @@map("activity_log")
}
