{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "chore/prueba-hook-vercel": false
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://mira-api-2epf.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
