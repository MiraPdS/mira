{
  "name": "mira",
  "private": true,
  "version": "0.1.0",
  "description": "Mira - Plataforma de gestion de proyectos Scrum y Kanban (INF331)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @mira/api",
    "dev:web": "npm run dev -w @mira/web",
    "build": "npm run build -w @mira/api && npm run build -w @mira/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project shared --project api-unit --project web",
    "test:integration": "vitest run --project api-integration",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "npm run db:reset -w @mira/api",
    "db:migrate": "npm run db:migrate -w @mira/api",
    "db:seed": "npm run db:seed -w @mira/api",
    "prepare": "node .husky/install.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
